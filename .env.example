NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-aqui
# Beta interna SOCideas: token para POST /api/socideas/sync/[codigoINE] y /api/socideas/sync-economia/[codigoINE]
# (cabecera x-sync-token). Generar con: openssl rand -hex 32
# NO sirve para /api/socideas/revalidate (B2: sin fallback).
SOCIDEAS_SYNC_TOKEN=cambia-este-valor-en-servidor
# Token DEDICADO de revalidación (B2): cabecera x-revalidate-token en
# POST /api/socideas/revalidate y en los loaders (cliente socideas-revalidate).
# Generar con: openssl rand -hex 32  (valor distinto de SOCIDEAS_SYNC_TOKEN)
SOCIDEAS_REVALIDATE_TOKEN=cambia-este-valor-dedicado-revalidate
# Base pública del endpoint de revalidación (loaders fuera de Vercel)
SOCIDEAS_REVALIDATE_BASE_URL=https://urb-ideas.vercel.app
# Flag interno para mostrar botones "Actualizar datos oficiales" y "Comprobar provisionales" en EconomiaFicha
NEXT_PUBLIC_SOCIDEAS_INTERNAL=false
# R2 (datos masivos SOCideas): la base pública no es secreta (solo URL);
# las credenciales S3 solo viven en servidor/scripts, nunca en el cliente.
NEXT_PUBLIC_SOCIDEAS_R2_BASE=https://pub-tu-id.r2.dev
R2_ACCOUNT_ID=tu-account-id
R2_ACCESS_KEY_ID=tu-access-key
R2_SECRET_ACCESS_KEY=tu-secret-key
R2_BUCKET=socideas-data
