{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "baseUrl": "..",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "./qa-adversarial-socideas.ts",
    "./qa-fixtures.ts",
    "../src/lib/**/*.ts",
    "../src/app/api/socideas/revalidate/**/*.ts"
  ]
}